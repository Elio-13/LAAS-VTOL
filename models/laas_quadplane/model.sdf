<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="laas_quadplane">
    <static>false</static>
    <link name="fuselage">
      <inertial>
        <mass>14.8</mass>
        <inertia>
          <ixx>3.0</ixx>
          <iyy>2.0</iyy>
          <izz>4.0</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry>
          <box>
            <size>1.8 0.18 0.20</size>
          </box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box>
            <size>1.8 0.18 0.20</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.75 0.75 0.80 1</diffuse>
        </material>
      </visual>
      <visual name="wing_visual">
        <pose>0.10 0 0.08 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 3.30 0.04</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.15 0.35 0.85 1</diffuse>
        </material>
      </visual>
      <visual name="vtail_left">
        <pose>-0.75 0.25 0.12 0.65 0 0</pose>
        <geometry>
          <box>
            <size>0.30 0.55 0.025</size>
          </box>
        </geometry>
      </visual>
      <visual name="vtail_right">
        <pose>-0.75 -0.25 0.12 -0.65 0 0</pose>
        <geometry>
          <box>
            <size>0.30 0.55 0.025</size>
          </box>
        </geometry>
      </visual>
      <visual name="pusher">
        <pose>-0.95 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="wing_visual_collision">
        <pose>0.10 0 0.08 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 3.30 0.04</size>
          </box>
        </geometry>
      </collision>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>true</always_on>
        <update_rate>250</update_rate>
        <imu>
          <orientation_reference_frame>
            <localization>ENU</localization>
          </orientation_reference_frame>
        </imu>
      </sensor>
    </link>
    <link name="rotor_fl">
      <pose>0.45 0.75 0.15 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.00036</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="rotor_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="rotor_fl_joint" type="revolute">
      <parent>fuselage</parent>
      <child>rotor_fl</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <link name="rotor_fr">
      <pose>0.45 -0.75 0.15 0 0 0</pose>
